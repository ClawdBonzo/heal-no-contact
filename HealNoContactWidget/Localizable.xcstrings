    "Your streak, counting up on its own — and one tap to check in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Serie zählt von selbst weiter – und ein Fingertipp genügt zum Einchecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu racha avanza sola, y con un toque haces tu registro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu racha avanza sola, y con un toque haces tu registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre série avance toute seule — et un simple toucher suffit pour faire le point."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua serie avanza da sola e con un tocco fai il check-in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sequência conta sozinha — e um toque faz o check-in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reeks telt vanzelf door – en inchecken kost één tik."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سلسلتك تتقدّم تلقائيًا، ونقرة واحدة لتسجيل حالتك."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สตรีคของคุณนับต่อเอง แตะครั้งเดียวเพื่อเช็กอิน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak-mu bertambah sendiri — dan sekali ketuk untuk check-in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serin kendiliğinden ilerler — kontrol için tek dokunuş."
          }
        }
      }
    },
