    "One tap to breathing, coping strategies and your mantra when the urge hits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Fingertipp zu Atemübungen, Strategien und deinem Mantra, wenn der Drang kommt."
          }
        },
        "es": {
