    "Healing isn't linear. Come back when you're ready — today is a good day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heilung verläuft nicht geradlinig. Komm zurück, wenn du bereit bist – heute ist ein guter Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanar no es un camino recto. Vuelve cuando sientas que es el momento — hoy es un buen día."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanar no es un camino recto. Vuelve cuando sientas que es el momento — hoy es un buen día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La guérison n’est pas linéaire. Revenez quand vous vous en sentirez capable — aujourd’hui est un bon jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La guarigione non è lineare. Torna quando te la senti — oggi è un buon giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cura não é linear. Volte quando sentir que é a hora — hoje é um bom dia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel verloopt niet in een rechte lijn. Kom terug wanneer je er klaar voor bent — vandaag is een goede dag."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التعافي ليس خطًا مستقيمًا. عد عندما تكون مستعدًا — اليوم يوم جيد."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเยียวยาไม่ได้เป็นเส้นตรง กลับมาเมื่อคุณพร้อม — วันนี้เป็นวันที่ดี"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemulihan tidak berjalan lurus. Kembalilah saat kamu siap — hari ini adalah hari yang baik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyileşme doğrusal değildir. Hazır olduğunda geri dön — bugün iyi bir gün."
          }
        }
      }
    },
    "Your peace is worth protecting": {
      "localizations": {
