      }
    },
    "You survived what you thought would kill you. Now straighten your crown and move forward like the warrior you are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast überlebt, wovon du dachtest, es würde dich umbringen. Richte jetzt deine Krone und geh weiter wie die Kämpfernatur, die du bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobreviviste a lo que creías que te destruiría. Ahora endereza tu corona y avanza como el guerrero que eres."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobreviviste a lo que creíste que te destruiría. Ahora endereza tu corona y avanza como el guerrero que eres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez survécu à ce que vous croyiez fatal. Maintenant, redressez votre couronne et avancez comme le guerrier que vous êtes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sopravvissuto a ciò che pensavi ti avrebbe ucciso. Ora raddrizza la corona e va' avanti come il guerriero che sei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você sobreviveu ao que achava que te destruiria. Agora ajeite sua coroa e siga em frente como a guerreira que você é."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt overleefd wat je dacht niet te overleven. Zet nu je kroon recht en ga verder als de strijder die je bent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نجوت مما ظننت أنه سيقضي عليك. والآن عدّل تاجك وامضِ قدمًا كالمحارب الذي أنت عليه."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณรอดจากสิ่งที่คิดว่าจะทำลายคุณมาได้ ตอนนี้จงสวมมงกุฎให้ตรงและก้าวต่อไปอย่างนักรบที่คุณเป็น"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu selamat dari hal yang kamu kira akan menghancurkanmu. Sekarang tegakkan mahkotamu dan melangkah maju seperti pejuang sejati."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni öldüreceğini sandığın şeyden sağ çıktın. Şimdi tacını düzelt ve olduğun savaşçı gibi yoluna devam et."
          }
        }
      }
    },
