    "Missing someone is part of healing. It doesn't mean you should go back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemanden zu vermissen gehört zur Heilung. Es heißt nicht, dass du zurückgehen solltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Echar de menos a alguien es parte de sanar. No significa que debas volver."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrañar a alguien es parte de sanar. No significa que debas volver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressentir le manque fait partie de la guérison. Ça ne veut pas dire qu’il faut revenir en arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentire la mancanza di qualcuno fa parte della guarigione. Non significa che dovresti tornare indietro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentir saudade faz parte da cura. Isso não significa que você deva voltar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand missen hoort bij herstel. Het betekent niet dat je terug moet gaan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاشتياق إلى شخص ما جزء من التعافي. لكنه لا يعني أن عليك العودة."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การคิดถึงใครสักคนเป็นส่วนหนึ่งของการเยียวยา ไม่ได้แปลว่าคุณควรกลับไป"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merindukan seseorang adalah bagian dari pemulihan. Bukan berarti kamu harus kembali."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birini özlemek iyileşmenin bir parçasıdır. Geri dönmen gerektiği anlamına gelmez."
          }
        }
      }
    },
