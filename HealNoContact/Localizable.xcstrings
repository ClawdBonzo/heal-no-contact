    "Reopen Heal and pick up your journey — your future self will thank you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Heal wieder und setze deine Reise fort – dein zukünftiges Ich wird es dir danken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrir Heal y retoma tu camino — tu yo del futuro te lo agradecerá."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrir Heal y retoma tu camino — tu yo del futuro te lo agradecerá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrez Heal et reprenez votre parcours — vous vous en remercierez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapri Heal e riprendi il tuo percorso — il te del futuro ti ringrazierà."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Heal de novo e retome sua jornada — seu eu do futuro vai agradecer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Heal opnieuw en pak je reis weer op — je toekomstige zelf zal je dankbaar zijn."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Heal من جديد واستأنف رحلتك — نسختك المستقبلية ستشكرك."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Heal อีกครั้งและสานต่อเส้นทางของคุณ — ตัวคุณในอนาคตจะขอบคุณคุณ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka lagi Heal dan lanjutkan perjalananmu — dirimu di masa depan akan berterima kasih."
          }
        },
        "tr": {
