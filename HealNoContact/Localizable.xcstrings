        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل لحظة مقاومة هي انتصار."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกครั้งที่ห้ามใจได้คือชัยชนะ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap momen bertahan adalah sebuah kemenangan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Direndiğin her an bir zaferdir."
          }
        }
      }
    },
    "Your future self will thank you for staying strong today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein zukünftiges Ich wird dir danken, dass du heute stark geblieben bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu yo del futuro te agradecerá que hoy te hayas mantenido fuerte."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu yo del futuro te agradecerá haberte mantenido fuerte hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tard, vous vous remercierez d’avoir tenu bon aujourd’hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il te del futuro ti ringrazierà per aver tenuto duro oggi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu eu do futuro vai agradecer por você ter se mantido firme hoje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je toekomstige zelf zal je dankbaar zijn dat je vandaag sterk bent gebleven."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسختك المستقبلية ستشكرك على صمودك اليوم."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวคุณในอนาคตจะขอบคุณที่วันนี้คุณเข้มแข็งไว้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirimu di masa depan akan berterima kasih karena kamu tetap kuat hari ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelecekteki sen, bugün güçlü kaldığın için sana teşekkür edecek."
          }
        }
      }
    },
    "Healing happens one brave moment at a time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heilung geschieht einen mutigen Moment nach dem anderen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanar es avanzar un momento de valentía tras otro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La sanación ocurre un momento de valentía a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La guérison se construit un instant de courage à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La guarigione avviene un momento di coraggio alla volta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cura acontece um momento de coragem de cada vez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel bouw je op, moedig moment na moedig moment."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التعافي يحدث لحظة شجاعة تلو الأخرى."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเยียวยาเกิดขึ้นทีละช่วงเวลาแห่งความกล้า"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemulihan terjadi satu momen berani demi satu momen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyileşme, cesur anların birikmesiyle olur."
          }
        }
      }
    },
    "You chose yourself today. That takes courage.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dich heute für dich entschieden. Das erfordert Mut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy te has elegido a ti. Eso requiere valor."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy te elegiste a ti. Eso requiere valor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, vous avez fait le choix de vous-même. Ça demande du courage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi hai scelto te stesso. Ci vuole coraggio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje você se escolheu. Isso exige coragem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt vandaag voor jezelf gekozen. Daar is moed voor nodig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخترت نفسك اليوم. وهذا يتطلب شجاعة."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้คุณเลือกตัวเอง นั่นต้องใช้ความกล้า"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memilih dirimu sendiri hari ini. Itu butuh keberanian."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün kendini seçtin. Bu cesaret ister."
          }
        }
      }
    },
    "The urge is temporary. Your growth is permanent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drang ist vorübergehend. Dein Wachstum bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El impulso es pasajero. Tu crecimiento es permanente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El impulso es temporal. Tu crecimiento es permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envie est passagère. Vos progrès, eux, sont permanents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'impulso è passeggero. La tua crescita è permanente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A vontade é passageira. Seu crescimento é permanente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De drang is tijdelijk. Je groei is blijvend."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرغبة الملحّة مؤقتة. أما نموّك فدائم."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความอยากเป็นเพียงชั่วคราว แต่การเติบโตของคุณคงอยู่ถาวร"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorongan itu sementara. Pertumbuhanmu permanen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dürtü geçici. Gelişimin kalıcı."
          }
        }
      }
    },
    "You're not just surviving — you're becoming.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du überlebst nicht nur – du wächst über dich hinaus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No solo estás sobreviviendo — te estás transformando."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No solo estás sobreviviendo — te estás transformando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne faites pas que survivre — vous vous transformez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non stai solo sopravvivendo — stai diventando chi sei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não está apenas sobrevivendo — você está se transformando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je overleeft niet alleen — je wordt wie je bent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت لا تنجو فحسب — بل تتحول إلى شخص جديد."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณไม่ได้แค่เอาตัวรอด — คุณกำลังเติบโตเป็นคนใหม่"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bukan sekadar bertahan — kamu sedang bertumbuh menjadi dirimu yang baru."
          }
        },
