    "%lld days of no contact so far. Keep your insights, reminders and export — or cancel anytime in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon %lld Tage ohne Kontakt. Behalte deine Einblicke, Erinnerungen und den Export – oder kündige jederzeit in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas %lld días sin contacto. Conserva tus estadísticas, mensajes de motivación y la exportación, o cancela cuando quieras en Ajustes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas %lld días sin contacto. Conserva tus estadísticas, recordatorios y la exportación, o cancela cuando quieras en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà %lld jours sans contact. Gardez vos analyses, vos rappels et l’export — ou annulez à tout moment dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già %lld giorni senza contatti. Mantieni analisi, promemoria ed esportazione, oppure disdici quando vuoi in Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já são %lld dias sem contato. Mantenha seus insights, lembretes e a exportação — ou cancele quando quiser em Configurações."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al %lld dagen zonder contact. Houd je inzichten, herinneringen en export — of zeg op wanneer je wilt via Instellingen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد أيامك بلا تواصل حتى الآن: %lld. احتفظ برؤاك وتذكيراتك والتصدير، أو ألغِ في أي وقت من الإعدادات."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ติดต่อมาแล้ว %lld วัน เก็บข้อมูลเชิงลึก การแจ้งเตือน และการส่งออกไว้ต่อ หรือยกเลิกได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah %lld hari tanpa kontak. Pertahankan wawasan, pengingat, dan ekspor — atau batalkan kapan saja di Pengaturan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdiye kadar %lld gün iletişimsiz. İçgörülerini, hatırlatmalarını ve dışa aktarmayı koru — ya da istediğin zaman Ayarlar'dan iptal et."
          }
        }
      }
    },
