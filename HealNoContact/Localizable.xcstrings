        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเข้มแข็งกว่าที่คิด สู้ต่อไป"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu lebih kuat dari yang kamu kira. Terus maju."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandığından daha güçlüsün. Devam et."
          }
        }
      }
    },
    "Every moment of resistance is a victory.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Moment des Widerstands ist ein Sieg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada momento de resistencia es una victoria."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada momento de resistencia es una victoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque instant de résistance est une victoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni momento di resistenza è una vittoria."
          }
        },
        "pt-BR": {
          "stringUnit": {
