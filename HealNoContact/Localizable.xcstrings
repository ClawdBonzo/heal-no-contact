    "Every streak starts at day 0. Get through this moment and day 1 is yours.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Serie beginnt bei Tag 0. Überstehe diesen Moment, und Tag 1 gehört dir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda racha empieza en el día 0. Supera este momento y el día 1 será tuyo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda racha empieza en el día 0. Supera este momento y el día 1 será tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque série commence au jour 0. Surmontez ce moment et le jour 1 sera à vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni serie inizia dal giorno 0. Supera questo momento e il giorno 1 sarà tuo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda sequência começa no dia 0. Atravesse este momento e o dia 1 será seu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke reeks begint op dag 0. Kom dit moment door en dag 1 is van jou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل سلسلة تبدأ من اليوم ٠. اعبر هذه اللحظة وسيكون اليوم ١ من نصيبك."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกสตรีคเริ่มต้นที่วันที่ 0 ผ่านช่วงเวลานี้ไปให้ได้ แล้ววันที่ 1 จะเป็นของคุณ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap streak dimulai dari hari ke-0. Lewati momen ini dan hari ke-1 jadi milikmu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her seri 0. günde başlar. Bu anı atlat, 1. gün senin olsun."
          }
        }
      }
    },
