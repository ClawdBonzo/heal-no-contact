    "Rock bottom became the solid foundation on which I rebuilt my life.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der tiefste Punkt wurde zum festen Fundament, auf dem ich mein Leben neu aufbaute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar fondo se convirtió en la base sólida sobre la que reconstruí mi vida."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar fondo se convirtió en la base sólida sobre la que reconstruí mi vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fond du gouffre est devenu le socle solide sur lequel j’ai reconstruit ma vie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il punto più basso è diventato la solida base su cui ho ricostruito la mia vita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fundo do poço virou a base sólida sobre a qual reconstruí minha vida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het diepste dal werd het stevige fundament waarop ik mijn leven opnieuw opbouwde."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح القاع الصخري الأساس المتين الذي أعدت بناء حياتي عليه."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จุดต่ำสุดกลายเป็นรากฐานอันมั่นคงที่ฉันใช้สร้างชีวิตขึ้นมาใหม่"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Titik terendah menjadi fondasi kokoh tempat aku membangun kembali hidupku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibe vurmak, hayatımı üzerine yeniden inşa ettiğim sağlam temel oldu."
          }
        }
      }
    },
