    "This will appear on your dashboard as a daily reminder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies erscheint als tägliche Erinnerung auf deiner Startseite"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecerá en tu panel como recordatorio diario"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto aparecerá en tu inicio como un recordatorio diario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela apparaîtra sur votre tableau de bord comme rappel quotidien"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparirà sulla tua dashboard come promemoria giornaliero"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso aparecerá no seu painel como um lembrete diário"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verschijnt op je dashboard als dagelijkse herinnering"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر هذا على لوحتك الرئيسية كتذكير يومي"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความนี้จะแสดงบนแดชบอร์ดของคุณเพื่อเตือนใจทุกวัน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan muncul di dasbor sebagai pengingat harianmu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, ana sayfanda günlük bir hatırlatma olarak görünecek"
          }
        }
      }
    },
    "This will permanently delete all your journal entries, mood data, milestones, and profile. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle deine Tagebucheinträge, Stimmungsdaten, Meilensteine und dein Profil dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará de forma permanente todas tus entradas del diario, datos de ánimo, hitos y perfil. No se puede deshacer."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente todas tus entradas del diario, datos de ánimo, hitos y perfil. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprimera définitivement toutes vos entrées de journal, vos données d’humeur, vos étapes et votre profil. C’est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione eliminerà definitivamente tutte le voci del diario, i dati sull'umore, i traguardi e il profilo. Non potrà essere annullata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso vai excluir permanentemente todas as suas anotações do diário, seus dados de humor, seus marcos e seu perfil. Não há como desfazer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee verwijder je permanent al je dagboeknotities, stemmingsgegevens, mijlpalen en je profiel. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جميع تدوينات يومياتك وبيانات مزاجك وإنجازاتك وملفك الشخصي نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบบันทึกประจำวัน ข้อมูลอารมณ์ หลักชัย และโปรไฟล์ของคุณทั้งหมดอย่างถาวร และไม่สามารถเลิกทำได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus secara permanen semua catatan jurnal, data suasana hati, tonggak pencapaian, dan profilmu. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem tüm günlük kayıtlarını, ruh hali verilerini, kilometre taşlarını ve profilini kalıcı olarak silecek. Bu geri alınamaz."
          }
        }
      }
    },
