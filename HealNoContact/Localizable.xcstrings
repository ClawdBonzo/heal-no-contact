          "stringUnit": {
            "state": "translated",
            "value": "Escribe todo lo que quieras decir.\nEsta carta nunca se enviará: es para ti."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe todo lo que quieras decir.\nEsta carta nunca se enviará — es para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez tout ce que vous avez sur le cœur.\nCette lettre ne sera jamais envoyée — elle est pour vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi tutto ciò che vuoi dire.\nQuesta lettera non verrà mai inviata — è per te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva tudo o que você quer dizer.\nEsta carta nunca será enviada — ela é para você."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf alles op wat je wilt zeggen.\nDeze brief wordt nooit verstuurd — hij is voor jou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب كل ما تريد قوله.\nلن تُرسل هذه الرسالة أبدًا — إنها لك أنت."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนทุกสิ่งที่คุณอยากพูดออกมา\nจดหมายนี้จะไม่ถูกส่งไปไหน — มันมีไว้เพื่อคุณ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis semua yang ingin kamu katakan.\nSurat ini tidak akan pernah dikirim — ini untukmu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Söylemek istediğin her şeyi yaz.\nBu mektup asla gönderilmeyecek — o senin için."
          }
        }
      }
    },
    "Write it out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles aufschreiben"
          }
        },
        "es": {
