    "Your value doesn't decrease based on someone's inability to see your worth.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wert sinkt nicht, weil jemand nicht fähig ist, ihn zu erkennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu valor no disminuye porque alguien no sepa verlo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu valor no disminuye porque alguien no sepa verlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre valeur ne diminue pas parce que quelqu’un est incapable de la voir."
          }
