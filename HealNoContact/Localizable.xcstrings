    "What triggered you today and how did you handle it?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hat dich heute getriggert und wie bist du damit umgegangen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te ha removido hoy y cómo lo has gestionado?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te detonó hoy y cómo lo manejaste?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel a été votre déclencheur aujourd’hui, et comment l’avez-vous géré ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ti ha fatto scattare oggi e come l'hai gestito?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual foi o seu gatilho hoje e como você lidou com ele?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat triggerde je vandaag en hoe ben je ermee omgegaan?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي أثار مشاعرك اليوم وكيف تعاملت معه؟"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้อะไรกระตุ้นความรู้สึกของคุณ และคุณรับมือกับมันอย่างไร"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang memicumu hari ini dan bagaimana kamu menghadapinya?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün seni ne tetikledi ve bununla nasıl başa çıktın?"
          }
        }
      }
    },
    "Write about something you're grateful for.": {
      "localizations": {
        "de": {
