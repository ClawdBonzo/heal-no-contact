    "Honesty takes courage. Your streak will reset, but your growth won't.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehrlichkeit braucht Mut. Deine Serie beginnt neu, dein Wachstum bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser honesto requiere valor. Tu racha se reiniciará, pero tu crecimiento no."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser honesto toma valor. Tu racha se reiniciará, pero tu crecimiento no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’honnêteté demande du courage. Votre série repart à zéro, mais pas vos progrès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'onestà richiede coraggio. La tua serie ripartirà, ma la tua crescita no."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser honesto exige coragem. Sua sequência será zerada, mas seu crescimento não."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerlijkheid vraagt moed. Je reeks wordt gereset, maar je groei niet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصدق يحتاج إلى شجاعة. ستُعاد سلسلتك إلى الصفر، لكن نموّك لن يُمحى."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความซื่อสัตย์ต้องใช้ความกล้า สตรีคของคุณจะถูกรีเซ็ต แต่การเติบโตของคุณจะไม่หายไป"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jujur itu butuh keberanian. Streak-mu akan direset, tapi pertumbuhanmu tidak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dürüstlük cesaret ister. Serin sıfırlanacak ama gelişimin sıfırlanmayacak."
          }
        }
      }
    },
