    "You are allowed to be both a masterpiece and a work in progress.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst zugleich ein Meisterwerk und ein Werk im Werden sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ser a la vez una obra maestra y un trabajo en progreso."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ser una obra maestra y un trabajo en proceso al mismo tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez le droit d’être à la fois un chef-d’œuvre et une œuvre en devenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai il diritto di essere allo stesso tempo un capolavoro e un'opera in divenire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ser, ao mesmo tempo, uma obra-prima e uma obra em construção."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mag tegelijk een meesterwerk en een werk in uitvoering zijn."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسموح لك أن تكون تحفة فنية وعملًا قيد الإنجاز في آنٍ واحد."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถเป็นทั้งผลงานชิ้นเอกและงานที่ยังสร้างไม่เสร็จได้ในเวลาเดียวกัน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu boleh menjadi mahakarya sekaligus karya yang masih dalam proses."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hem bir başyapıt hem de hâlâ tamamlanmakta olan bir eser olabilirsin."
          }
        }
      }
    },
    "You can't start the next chapter if you keep re-reading the last one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das nächste Kapitel nicht beginnen, wenn du immer wieder das letzte liest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes empezar el siguiente capítulo si sigues releyendo el anterior."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes empezar el siguiente capítulo si sigues releyendo el anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas commencer le prochain chapitre si vous relisez sans cesse le précédent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi iniziare il prossimo capitolo se continui a rileggere l'ultimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não consegue começar o próximo capítulo se continuar relendo o anterior."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt niet aan het volgende hoofdstuk beginnen als je het vorige blijft herlezen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك بدء الفصل التالي إذا واصلت إعادة قراءة الفصل الأخير."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณไม่อาจเริ่มบทต่อไปได้ หากยังอ่านบทเดิมซ้ำ ๆ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu tak bisa memulai bab berikutnya jika terus membaca ulang bab yang lalu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son bölümü tekrar tekrar okursan yeni bölüme başlayamazsın."
          }
        }
      }
    },
    "You did it!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast es geschafft!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Lo has conseguido!"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Lo lograste!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez réussi !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce l'hai fatta!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você conseguiu!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is je gelukt!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد فعلتها!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณทำได้แล้ว!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu berhasil!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başardın!"
          }
        }
      }
    },
    "You don't need closure from them. You need peace from within.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst keinen Abschluss von ihnen. Du brauchst Frieden in dir selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas que ellos cierren el ciclo. Necesitas paz dentro de ti."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas que esa persona te dé un cierre. Necesitas paz dentro de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas besoin que l’autre vous aide à tourner la page. Vous avez besoin de paix intérieure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai bisogno di chiusura da parte loro. Hai bisogno di pace dentro di te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não precisa que eles fechem esse ciclo. Você precisa de paz por dentro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt geen afsluiting van hen nodig. Je hebt rust van binnenuit nodig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لست بحاجة إلى خاتمة منهم. أنت بحاجة إلى سلام من داخلك."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณไม่ต้องการคำตอบสุดท้ายจากเขา คุณต้องการความสงบจากภายใน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu tidak butuh penutup dari mereka. Kamu butuh kedamaian dari dalam dirimu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondan bir kapanışa ihtiyacın yok. İçindeki huzura ihtiyacın var."
          }
        }
      }
    },
    "You resisted the urge.\nThat takes real strength.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dem Drang widerstanden.\nDas erfordert echte Stärke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has resistido el impulso.\nEso requiere verdadera fuerza."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Resististe el impulso.\nEso requiere verdadera fortaleza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez résisté à l’envie.\nCela demande une vraie force."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai resistito all'impulso.\nCi vuole vera forza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você resistiu à vontade.\nIsso exige uma força de verdade."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de drang weerstaan.\nDaar is echte kracht voor nodig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاومت الرغبة الملحّة.\nهذا يتطلب قوة حقيقية."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณห้ามใจไม่ให้ติดต่อไปได้\nนั่นต้องใช้ความเข้มแข็งอย่างแท้จริง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu berhasil menahan dorongan itu.\nItu butuh kekuatan yang nyata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dürtüye direndin.\nBu gerçek bir güç ister."
          }
        }
      }
    },
    "You started your healing journey": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast deine Heilungsreise begonnen"
          }
