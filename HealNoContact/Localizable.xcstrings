    "Then %@/month. Cancel anytime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach %@/Monat. Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, %@/mes. Cancela cuando quieras."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Después %@/mes. Cancela cuando quieras."
          }
