    "Your healing score, mood pattern detection, and weekly summaries are part of Heal Premium.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Heilungs-Score, die Stimmungsmuster-Erkennung und Wochenübersichten sind Teil von Heal Premium."
          }
        },
        "es": {
          "stringUnit": {
