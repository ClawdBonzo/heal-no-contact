    "Letting go doesn't mean giving up, it means moving on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loslassen heißt nicht aufgeben, es heißt weitergehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soltar no significa rendirse, significa seguir adelante."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Soltar no significa rendirse, significa seguir adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lâcher prise ne veut pas dire abandonner, mais avancer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciare andare non significa arrendersi, significa andare avanti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar ir não é desistir, é seguir em frente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loslaten betekent niet opgeven, het betekent verdergaan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التخلي لا يعني الاستسلام، بل يعني المضي قدمًا."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปล่อยวางไม่ได้แปลว่ายอมแพ้ แต่แปลว่าก้าวต่อไป"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melepaskan bukan berarti menyerah, melainkan melangkah maju."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bırakmak pes etmek değildir; yoluna devam etmektir."
          }
        }
      }
    },
