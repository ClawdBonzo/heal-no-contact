    "A quick check-in keeps your momentum going. How are you today?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzes Check-in hält deinen Schwung aufrecht. Wie geht es dir heute?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro rápido mantiene tu impulso. ¿Cómo estás hoy?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro rápido te ayuda a mantener el ritmo. ¿Cómo estás hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point rapide entretient votre élan. Comment allez-vous aujourd’hui ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un check-in veloce mantiene vivo il tuo slancio. Come stai oggi?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um check-in rápido mantém seu ritmo. Como você está hoje?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een snelle check-in houdt je momentum vast. Hoe gaat het vandaag?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل سريع لحالتك يحافظ على زخمك. كيف حالك اليوم؟"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช็กอินสั้น ๆ ช่วยรักษาแรงส่งของคุณไว้ วันนี้เป็นอย่างไรบ้าง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-in singkat menjaga momentummu tetap berjalan. Bagaimana kabarmu hari ini?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa bir ruh hali kaydı ivmeni korur. Bugün nasılsın?"
