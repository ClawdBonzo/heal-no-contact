    "No contact is not about them. It's about you choosing yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Kontaktsperre geht es nicht um die andere Person. Es geht darum, dass du dich für dich entscheidest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contacto cero no va sobre ellos. Va sobre que te elijas a ti."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No tener contacto no se trata de esa persona. Se trata de que te elijas a ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le no contact n’a rien à voir avec l’autre. Il s’agit de vous choisir, vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il no contact non riguarda loro. Riguarda te che scegli te stesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contato zero não é sobre eles. É sobre você se escolher."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "No contact gaat niet over hen. Het gaat erom dat jij voor jezelf kiest."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قطع التواصل لا يتعلق بهم. بل يتعلق باختيارك لنفسك."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การไม่ติดต่อไม่ได้เกี่ยวกับเขา แต่เกี่ยวกับการที่คุณเลือกตัวเอง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "No contact bukan tentang mereka. Ini tentang kamu memilih dirimu sendiri."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İletişimi kesmek onunla ilgili değil. Kendini seçmenle ilgili."
          }
        }
      }
    },
