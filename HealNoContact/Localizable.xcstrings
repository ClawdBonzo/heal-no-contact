    "Nights can be tough. You've got this.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächte können hart sein. Du schaffst das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noches pueden ser duras. Tú puedes con esto."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noches pueden ser difíciles. Tú puedes con esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nuits peuvent être dures. Vous allez y arriver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notti possono essere dure. Ce la fai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As noites podem ser difíceis. Você consegue."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachten kunnen zwaar zijn. Jij kunt dit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تكون الليالي صعبة. أنت قادر على ذلك."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่ำคืนอาจยากลำบาก แต่คุณผ่านมันไปได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam hari bisa terasa berat. Kamu pasti bisa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geceler zor olabilir. Sen bunu başarırsın."
          }
        }
      }
    },
