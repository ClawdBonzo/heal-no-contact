          }
        }
      }
    },
    "You're stronger than you think. Keep going.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist stärker, als du denkst. Mach weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres más fuerte de lo que crees. Sigue adelante."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres más fuerte de lo que crees. Sigue adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez plus de force que vous ne le croyez. Continuez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei più forte di quanto pensi. Continua così."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é mais forte do que pensa. Continue."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent sterker dan je denkt. Ga zo door."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت أقوى مما تظن. واصل المسير."
