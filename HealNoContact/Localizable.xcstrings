    "Sometimes the hardest part isn't letting go but learning to start over.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manchmal ist das Schwerste nicht das Loslassen, sondern zu lernen, neu zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A veces lo más difícil no es soltar, sino aprender a empezar de nuevo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "A veces lo más difícil no es soltar, sino aprender a empezar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfois, le plus dur n’est pas de lâcher prise, mais d’apprendre à tout recommencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A volte la parte più difficile non è lasciare andare, ma imparare a ricominciare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Às vezes o mais difícil não é deixar ir, mas aprender a recomeçar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soms is het moeilijkste niet loslaten, maar leren opnieuw te beginnen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحيانًا لا يكون الجزء الأصعب هو التخلي، بل تعلّم البدء من جديد."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บางครั้งส่วนที่ยากที่สุดไม่ใช่การปล่อยวาง แต่คือการเรียนรู้ที่จะเริ่มต้นใหม่"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terkadang bagian tersulit bukanlah melepaskan, melainkan belajar memulai lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazen en zor kısım bırakmak değil, yeniden başlamayı öğrenmektir."
          }
        }
      }
    },
