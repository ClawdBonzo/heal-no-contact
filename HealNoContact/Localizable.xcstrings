    "A slip isn't the end. You can undo your reset for %lldh.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ausrutscher ist nicht das Ende. Du kannst das Zurücksetzen innerhalb von %lldh rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un desliz no es el final. Puedes deshacer el reinicio durante %lldh."
