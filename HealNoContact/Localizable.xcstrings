    "Growth is painful. Change is painful. But nothing is as painful as staying stuck.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachstum tut weh. Veränderung tut weh. Doch nichts tut so weh, wie stehen zu bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crecer duele. Cambiar duele. Pero nada duele tanto como quedarte atascado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Crecer duele. Cambiar duele. Pero nada duele tanto como quedarse estancado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandir fait mal. Changer fait mal. Mais rien ne fait plus mal que de rester figé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crescere fa male. Cambiare fa male. Ma niente fa più male del restare bloccati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crescer dói. Mudar dói. Mas nada dói tanto quanto continuar preso no mesmo lugar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groeien doet pijn. Veranderen doet pijn. Maar niets doet zo'n pijn als vast blijven zitten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النمو مؤلم. والتغيير مؤلم. لكن لا شيء أشد إيلامًا من البقاء عالقًا في مكانك."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเติบโตนั้นเจ็บปวด การเปลี่ยนแปลงนั้นเจ็บปวด แต่ไม่มีอะไรเจ็บปวดเท่าการติดอยู่กับที่"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bertumbuh itu menyakitkan. Berubah itu menyakitkan. Tapi tidak ada yang lebih menyakitkan daripada terus terjebak di tempat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyümek acı verir. Değişmek acı verir. Ama hiçbir şey olduğun yerde kalmak kadar acı vermez."
          }
        }
      }
    },
