    "It's been a few days. One small step forward is still progress.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind ein paar Tage vergangen. Ein kleiner Schritt nach vorn ist trotzdem Fortschritt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Han pasado unos días. Un pequeño paso adelante sigue siendo progreso."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Han pasado unos días. Un pequeño paso adelante sigue siendo progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça fait quelques jours. Un petit pas en avant, c’est déjà un progrès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono passati alcuni giorni. Un piccolo passo avanti è comunque un progresso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já faz alguns dias. Um pequeno passo à frente ainda é progresso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is een paar dagen geleden. Eén kleine stap vooruit is nog steeds vooruitgang."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّت بضعة أيام. خطوة صغيرة إلى الأمام تظل تقدمًا."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
